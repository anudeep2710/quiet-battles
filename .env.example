DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
QB_ADMIN_KEY=replace-with-a-random-key-at-least-16-characters-long
QB_ADMIN_EMAIL=owner@example.com
QB_ADMIN_PASSWORD_HASH=replace-with-salt-and-scrypt-hash
